# Copy this to .env and fill in your values

# Tavily Search API — https://tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini API (primary extraction model) — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API (fallback extraction model, used if Gemini quota is exhausted) — https://console.groq.com/keys (free tier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Exa API (search provider for the Tech/Startup categories) — https://exa.ai (free tier)
EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Supabase — https://supabase.com (free tier available)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx
